# Port for the addon server (default: 7000)
PORT=7000

# Base URL of the torrent-search backend. Required for piratebay/HiddenBay
# catalogs and PornRips catalogs.
BACKEND_URL=https://your-backend.example.com

# Optional bearer token if the backend requires authentication.
ADDON_API_TOKEN=

# Optional ThePornDB / metadataapi.net API key for scene/performer metadata.
TPDB_API_KEY=

# Optional ThePornDB API base URL (default: https://api.metadataapi.net)
# TPDB_API_URL=https://api.metadataapi.net

# Optional StashDB API key (https://stashdb.org) — free invite required.
# Used by the addon for additional scene metadata via GraphQL.
STASHDB_API_KEY=

# Optional StashDB base URL (default: https://stashdb.org)
# STASHDB_API_URL=https://stashdb.org

# Optional external reference addon URL used as a metadata fallback for
# PornRips items. When set, the addon queries this addon's meta endpoint for
# enriched scene titles, covers, and descriptions when its own TPDB lookup
# finds no match. Leave unset to disable this fallback.
# REFERENCE_ADDON_URL=https://your-reference-addon.example.com

# ── Caching: Redis (hot) + optional MongoDB (persistent stores) ───────────────
# Redis backs all caches by default. When unset, caches degrade to no-ops.
#
# Resource caps for small VPS / Sliplane deployments (recommended on ~8 GB boxes):
#   Redis:  maxmemory 1gb
#          maxmemory-policy allkeys-lru
#   MongoDB:  --wiredTigerCacheSizeGB 0.5
#             (or storage.wiredTiger.engineConfig.cacheSizeGB: 0.5 in mongod.conf)
# These are service-level settings; configure them on the Redis/Mongo containers,
# not in this .env file.
#
# REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=
#
# Optional: offload the large, long-lived metadata stores (tpdb/stashdb shared,
# reference meta, resolved magnets, stash tags) off Redis into MongoDB to relieve
# Redis memory. Hot ephemeral caches stay on Redis. Unset = everything on Redis
# (no behavior change). See docs/configuration.md → "MongoDB" for all knobs.
# Credentials are separate from the URI (no URL-encoding needed for the password).
# MONGODB_URI=mongodb://mongo-mnmk.internal
# MONGO_USERNAME=admin
# MONGO_PASSWORD=
# MONGO_AUTH_SOURCE=admin     # auth database (default: admin)
# MONGODB_DB=torrent_search
# MONGO_COLLECTION=cache
# MONGO_HOT=1                 # in-process LRU read-through (0 to disable)
# MONGO_HOT_MAX=5000
# MONGO_HOT_TTL_MS=60000

# Redis cache TTLs (seconds) — shorten to cap Redis memory. Defaults shown.
# Hot tier only; persistent stores keep long TTLs (and live in Mongo when set).
# TTL_TORRENT_STORE_S=21600   # 6h  — torrent records (id carries the essentials)
# TTL_IMAGE_S=43200           # 12h — poster/cover URLs (fallback)
# TTL_STREAM_S=7200           # 2h  — debrid-resolved links
# TTL_CATALOG_S=900           # 15m — catalog torrent lists (jittered ±10%)
# TTL_PROXIED_CAT_S=900       # 15m — PornTube/Hentai catalog lists
# TTL_PERKEY_META_S=43200     # 12h — per-user TPDB/StashDB lookups
# TTL_CATEGORY_S=21600        # 6h  — category-catalog lists (warmer refreshes ~3h)
# TTL_SECTION_S=300           # 5m  — backend section/config blob

# ── Data plane (scraping, warmers, enrichment) lives in the Go backend ────────
# The addon is a thin Stremio edge: it proxies manifest/catalog/meta to the Go
# torrent-search backend (BACKEND_URL) and resolves streams locally (per-user
# debrid keys). All scraping, catalog warming, cover extraction and TPDB/StashDB
# enrichment run in Go — there are no background-job or offload toggles here.
# On the Go service, set ADDON_CACHE_BASE_URL / BASE_URL to this addon's
# BACKEND_URL so the shared cat:v1: Redis keys align.

# ── Profile / saved config (requires MONGODB_URI) ─────────────────────────────
# Secret used to derive encryption keys for saved user profiles (AES-256-GCM).
# Must be a random string of 32+ characters. If unset, a random value is used
# per process start, which means all saved profiles are lost on every restart.
# Generate: openssl rand -hex 32
SESSION_SECRET=

# ── Rate limiting (per-IP request caps) ───────────────────────────────────────
# RATE_LIMIT_WINDOW_MS=60000         # sliding window length
# RATE_LIMIT_STREMIO_MAX=300         # per-IP cap for catalog/meta/stream/manifest
# RATE_LIMIT_GLOBAL_MAX=600          # app-wide per-IP flood ceiling
